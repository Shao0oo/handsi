{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handsi",
  "version": "0.1.2",
  "identifier": "com.handsi.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "../config/default.yaml"
    ],
    "externalBin": [
      "bin/handsi-backend"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "exceptionDomain": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Handsi Control Panel",
        "width": 900,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
